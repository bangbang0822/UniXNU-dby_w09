* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.mm text eol=lf
*.rs text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.patch text eol=lf -whitespace
*.png binary
*.jpg binary
*.efi binary
*.dtb binary
*.bin binary
*.a binary
*.o binary

# Handover packages are kept as they arrived, byte for byte, so their checksums stay true: no
# end-of-line conversion, no whitespace normalisation.
docs/handover/** -text

